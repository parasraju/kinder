{
  "name": "kinder-apply",
  "version": "1.0.0",
  "private": true,
  "description": "Kinder — API discovery, key hygiene, and request workspace",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env TSX_TSCONFIG_PATH=tsconfig.server.json tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "cross-env NODE_ENV=production TSX_TSCONFIG_PATH=tsconfig.server.json tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test server/**/*.test.ts",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('data dir removed')\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.90.2",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.10"
  }
}
