# --- Kinder Apply configuration -------------------------------------------------
# Copy this file to `.env` and adjust values.

# API server port (the Vite dev server proxies /api here)
PORT=8787

# Public origin of the app. Used for cookie security and CORS-free same-origin calls.
APP_ORIGIN=http://localhost:5173

# Required in production. 32-byte base64 key that encrypts stored provider
# credentials and GitHub tokens with AES-256-GCM.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Directory for the SQLite database (relative to the project root).
DATA_DIR=data

# Session lifetime in days.
SESSION_TTL_DAYS=14

# Seed a demo account on first boot (demo@kinderapply.dev / kinderdemo123).
SEED_DEMO=true

# Optional: default GitHub token used only when a user explicitly requests a
# public-repository scan without connecting their own account. Prefer connecting
# a token from Settings → Integrations.
GITHUB_TOKEN=
